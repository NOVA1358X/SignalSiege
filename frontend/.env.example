# Environment variables for SignalSiege frontend
# Copy this file to .env.local and fill in the values

# Linera faucet URL (testnet)
VITE_LINERA_FAUCET_URL=https://faucet.testnet-conway.linera.net

# Application ID (fill after deployment)
VITE_APPLICATION_ID=

# Hub chain ID (fill after deployment)
VITE_HUB_CHAIN_ID=

# Dynamic.xyz environment ID
VITE_DYNAMIC_ENVIRONMENT_ID=d6b08b9e-ea9c-4c6b-b937-0b4913d3e390
